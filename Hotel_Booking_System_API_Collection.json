{
  "info": {
    "_postman_id": "hotel-booking-microservices-api-v1",
    "name": "Hotel Booking System — Microservices API",
    "description": "Complete Postman API Collection for Hotel Booking Microservices Backend (API Gateway, User Service, Hotel Service, Booking Service, Wallet Service).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. User Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kiran Budachhetri\",\n  \"email\": \"kiran@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Registers a new customer account."
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var jwtToken = jsonData.token || (jsonData.data && jsonData.data.token);",
                  "if (jwtToken) {",
                  "    pm.collectionVariables.set('token', jwtToken);",
                  "    pm.environment.set('token', jwtToken);",
                  "    console.log('JWT Token auto-saved:', jwtToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kiran@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            },
            "description": "Authenticates user credentials and returns a JWT token. Auto-saves token."
          },
          "response": []
        },
        {
          "name": "Admin - Login Bypass (Testing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var jwtToken = jsonData.token || (jsonData.data && jsonData.data.token);",
                  "if (jwtToken) {",
                  "    pm.collectionVariables.set('adminToken', jwtToken);",
                  "    pm.environment.set('adminToken', jwtToken);",
                  "    console.log('Admin JWT Token auto-saved:', jwtToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/admin/login-bypass",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "admin", "login-bypass"]
            },
            "description": "Bypasses standard authentication to retrieve an owner JWT token (owner ID 1 to 5). Saves to adminToken."
          },
          "response": []
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Gets the profile information of the authenticated user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Wallet Service",
      "item": [
        {
          "name": "Load Funds into Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/wallet/load",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "load"]
            },
            "description": "Loads mock balance into user's wallet."
          },
          "response": []
        },
        {
          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallet/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "balance"]
            },
            "description": "Fetches current wallet balance."
          },
          "response": []
        },
        {
          "name": "Get Transactions Ledger",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallet/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallet", "transactions"]
            },
            "description": "Fetches payment ledger and transaction history."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Hotel Service",
      "item": [
        {
          "name": "List All Hotels",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"]
            },
            "description": "Fetches list of all hotels (cached in Redis)."
          },
          "response": []
        },
        {
          "name": "List All Rooms by Hotel ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels/:hotelId/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", ":hotelId", "rooms"],
              "variable": [
                {
                  "key": "hotelId",
                  "value": "1",
                  "description": "Change this to 1, 2, or 3 to view different hotels"
                }
              ]
            },
            "description": "Fetches all rooms for specified Hotel ID."
          },
          "response": []
        },
        {
          "name": "List Available Rooms by Hotel ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels/:hotelId/rooms/available",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", ":hotelId", "rooms", "available"],
              "variable": [
                {
                  "key": "hotelId",
                  "value": "1",
                  "description": "Change this to 1, 2, or 3 to view available rooms for different hotels"
                }
              ]
            },
            "description": "Fetches available rooms for specified Hotel ID."
          },
          "response": []
        },
        {
          "name": "Get Specific Room Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels/rooms/:roomId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "rooms", ":roomId"],
              "variable": [
                {
                  "key": "roomId",
                  "value": "1",
                  "description": "Room ID (e.g. 1 to 33)"
                }
              ]
            },
            "description": "Fetches room details for specific Room ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Booking Service",
      "item": [
        {
          "name": "Create Room Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 1,\n  \"checkIn\": \"2026-08-01\",\n  \"checkOut\": \"2026-08-03\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "description": "Creates a new room booking (triggers RabbitMQ async payment processing)."
          },
          "response": []
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "my"]
            },
            "description": "Fetches all bookings created by authenticated user."
          },
          "response": []
        },
        {
          "name": "Get Booking Details by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/:bookingId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", ":bookingId"],
              "variable": [
                {
                  "key": "bookingId",
                  "value": "1"
                }
              ]
            },
            "description": "Fetches booking details for Booking ID."
          },
          "response": []
        },
        {
          "name": "Admin - Get Hotel Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/admin/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "admin", "bookings"]
            },
            "description": "Allows hotel owner (ID 1-5) to fetch bookings for their hotel."
          },
          "response": []
        },
        {
          "name": "Admin - Approve Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/admin/bookings/:bookingId/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "admin", "bookings", ":bookingId", "approve"],
              "variable": [
                {
                  "key": "bookingId",
                  "value": "1"
                }
              ]
            },
            "description": "Allows hotel owner (ID 1-5) to approve a pending booking."
          },
          "response": []
        },
        {
          "name": "Admin - Update Booking Dates/Status (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"check_in\": \"2026-08-05\",\n  \"check_out\": \"2026-08-10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/admin/bookings/:bookingId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "admin", "bookings", ":bookingId"],
              "variable": [
                {
                  "key": "bookingId",
                  "value": "1"
                }
              ]
            },
            "description": "Allows hotel owner (ID 1-5) to modify check-in/out dates or status."
          },
          "response": []
        },
        {
          "name": "Admin - Delete Booking Entry",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/admin/bookings/:bookingId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "admin", "bookings", ":bookingId"],
              "variable": [
                {
                  "key": "bookingId",
                  "value": "1"
                }
              ]
            },
            "description": "Allows hotel owner (ID 1-5) to cancel a booking record (updates status to 'cancelled', updates is_paid status to 'returned', processes a full refund to the customer's wallet, and releases the room)."
          },
          "response": []
        }
      ]
    }
  ]
}
